<?xml version="1.0" encoding="utf-8"?>
<!-- Explicitly empty splash icon for Android 12+.

     The platform substitutes the application icon whenever
     windowSplashScreenAnimatedIcon is unset, which is why the launcher artwork
     appeared as the first frame even after the static one was removed.
     Declaring a transparent drawable here suppresses that substitution; the
     background colour alone is what the user sees before Flutter's own launch
     animation takes over. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size android:width="1dp" android:height="1dp" />
</shape>
